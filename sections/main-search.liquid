<section class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h1 class="section-head-title">
        {%- if search.performed and search.terms != blank -%}
          {{ section.settings.heading }}: {{ search.terms | escape }}
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h1>
      {%- if section.settings.intro != blank -%}
        <p class="lead">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    {%- comment -%} Search form posts to the Shopify search route. {%- endcomment -%}
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form" data-reveal>
      <label class="form-label" for="search-input-{{ section.id }}">{{ section.settings.input_label }}</label>
      <input class="form-input"
             id="search-input-{{ section.id }}"
             type="search"
             name="q"
             value="{{ search.terms | escape }}"
             placeholder="{{ section.settings.placeholder | escape }}"
             autocomplete="off">
      <button type="submit" class="btn btn--primary">{{ section.settings.submit_label }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <p class="lead" role="status">{{ section.settings.empty_text }}</p>
      {%- else -%}
        <p class="lead" role="status">{{ section.settings.results_text }} {{ search.results_count }}</p>

        <div class="grid grid--3" data-reveal-group>
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              <article class="product-card" data-reveal>
                <a class="product-card-media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                  {%- if item.featured_image -%}
                    <img src="{{ item.featured_image | image_url: width: 640 }}"
                         srcset="{{ item.featured_image | image_url: width: 320 }} 320w,
                                 {{ item.featured_image | image_url: width: 640 }} 640w,
                                 {{ item.featured_image | image_url: width: 960 }} 960w"
                         sizes="(max-width: 900px) 92vw, 33vw"
                         alt="{{ item.featured_image.alt | default: item.title | escape }}"
                         width="640" height="640" loading="lazy" decoding="async">
                  {%- else -%}
                    <img src="{{ 'insole-support.svg' | asset_url }}"
                         alt="{{ item.title | escape }}"
                         width="320" height="660" loading="lazy">
                  {%- endif -%}
                </a>

                <div class="product-card-body">
                  {%- unless item.available -%}
                    <span class="product-badge">{{ section.settings.sold_out_text }}</span>
                  {%- endunless -%}

                  <h2 class="product-card-title"><a href="{{ item.url }}">{{ item.title }}</a></h2>

                  {%- if item.description != blank -%}
                    <p class="product-desc">{{ item.description | strip_html | truncate: 140 }}</p>
                  {%- endif -%}

                  <div class="product-card-price">
                    {%- if item.compare_at_price > item.price -%}
                      <s>{{ item.compare_at_price | money }}</s>
                    {%- endif -%}
                    {{ item.price | money }}
                  </div>

                  <a class="btn btn--primary" href="{{ item.url }}">{{ section.settings.view_label }}</a>
                </div>
              </article>
            {%- else -%}
              <article class="card" data-reveal>
                <div class="product-card-body">
                  <span class="eyebrow">{{ section.settings.page_label }}</span>
                  <h2 class="product-card-title"><a href="{{ item.url }}">{{ item.title }}</a></h2>
                  {%- if item.content != blank -%}
                    <p class="product-desc">{{ item.content | strip_html | truncate: 140 }}</p>
                  {%- endif -%}
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Carian",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label kecil", "default": "Carian" },
    { "type": "text", "id": "heading", "label": "Tajuk", "default": "Hasil carian" },
    { "type": "textarea", "id": "intro", "label": "Pengenalan (pilihan)" },
    { "type": "header", "content": "Borang carian" },
    { "type": "text", "id": "input_label", "label": "Label medan carian", "default": "Kata kunci" },
    { "type": "text", "id": "placeholder", "label": "Teks contoh dalam medan", "default": "Cari produk..." },
    { "type": "text", "id": "submit_label", "label": "Label butang carian", "default": "Cari" },
    { "type": "header", "content": "Hasil carian" },
    { "type": "text", "id": "results_text", "label": "Teks bilangan hasil", "default": "Bilangan hasil:" },
    { "type": "text", "id": "empty_text", "label": "Teks tiada hasil", "default": "Tiada hasil untuk carian anda." },
    { "type": "text", "id": "sold_out_text", "label": "Teks habis stok", "default": "Habis" },
    { "type": "text", "id": "view_label", "label": "Label butang produk", "default": "Lihat" },
    { "type": "text", "id": "page_label", "label": "Label hasil bukan produk", "default": "Halaman" }
  ],
  "presets": [
    { "name": "Carian" }
  ]
}
{% endschema %}
