<section class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{{ 'cart.general.title' | t }}</span>
      <h1>{{ 'cart.general.heading' | t }}</h1>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <table class="cart-table">
          <thead>
            <tr>
              <th>{{ 'cart.general.product' | t }}</th>
              <th>{{ 'cart.general.price' | t }}</th>
              <th>{{ 'cart.general.quantity' | t }}</th>
              <th>{{ 'cart.general.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <a href="{{ item.url }}">{{ item.product.title }}</a>
                  {%- unless item.product.has_only_default_variant -%}
                    <small>{{ item.variant.title }}</small>
                  {%- endunless -%}
                </td>
                <td>{{ item.price | money }}</td>
                <td>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"
                         aria-label="{{ 'cart.general.quantity' | t }} {{ item.product.title | escape }}">
                </td>
                <td>{{ item.line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        <div class="summary-total">
          <span>{{ 'cart.general.total' | t }}</span><span>{{ cart.total_price | money }}</span>
        </div>

        <div class="hero-actions" style="margin-top:var(--s-4)">
          <button type="submit" name="update" class="btn btn--ghost">{{ 'cart.general.update' | t }}</button>
          <button type="submit" name="checkout" class="btn btn--primary btn--lg">{{ 'cart.general.checkout' | t }}</button>
        </div>
      </form>
    {%- else -%}
      <p>{{ 'cart.general.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">{{ 'cart.general.continue_shopping' | t }}</a>
    {%- endif -%}
  </div>
</section>
